generator client {
  provider = "prisma-client-js"
}

// Introspected from the EXISTING Neon database via `prisma db pull`.
// Do NOT run prisma migrate reset or prisma db push against production.


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String          @id(map: "PK_UsersSet") @map("Id") @db.Uuid
  phone                       String          @unique(map: "IX_UsersSet_Phone") @map("Phone")
  fullName                    String?         @map("FullName")
  email                       String?         @map("Email")
  gender                      Int?            @map("Gender")
  avatarUrl                   String?         @map("AvatarUrl")
  userType                    Int             @map("UserType")
  ratingAverage               Decimal         @map("RatingAverage") @db.Decimal
  ratingCount                 Int             @map("RatingCount")
  fcmToken                    String?         @map("FcmToken")
  isActive                    Boolean         @map("IsActive")
  createdAt                   DateTime        @map("CreatedAt") @db.Timestamptz(6)
  updatedAt                   DateTime?       @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted                   Boolean         @map("IsDeleted")
  facebookProviderId          String?         @map("FacebookProviderId")
  googleProviderId            String?         @map("GoogleProviderId")
  activeSubscriptionPackageId String?         @map("ActiveSubscriptionPackageId") @db.Uuid
  subscriptionExpiresAt       DateTime?       @map("SubscriptionExpiresAt") @db.Timestamptz(6)
  subscriptionActivatedAt     DateTime?       @map("SubscriptionActivatedAt") @db.Timestamptz(6)
  bookings                    Booking[]
  driver                      Driver?
  groupMemberships            GroupMember[]
  organizedGroups             GroupRequest[]  @relation("GroupOrganizer")
  notifications               Notification[]
  refreshTokens               RefreshToken[]
  reviews                     Review[]
  rideRequests                RideRequest[]   @relation("RideRider")
  routeRequests               RouteRequest[]
  savedLocations              SavedLocation[]
  supportTickets              SupportTicket[]
  userDevices                 UserDevice[]
  wallet                      Wallet?

  @@map("UsersSet")
}

model OtpRequest {
  id        String    @id(map: "PK_OtpRequestsSet") @map("Id") @db.Uuid
  phone     String    @map("Phone")
  codeHash  String    @map("CodeHash")
  purpose   Int       @map("Purpose")
  expiresAt DateTime  @map("ExpiresAt") @db.Timestamptz(6)
  attempts  Int       @map("Attempts")
  isUsed    Boolean   @map("IsUsed")
  createdAt DateTime  @map("CreatedAt") @db.Timestamptz(6)
  updatedAt DateTime? @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted Boolean   @map("IsDeleted")

  @@map("OtpRequestsSet")
}

model RefreshToken {
  id              String    @id(map: "PK_RefreshTokensSet") @map("Id") @db.Uuid
  userId          String    @map("UserId") @db.Uuid
  token           String    @unique(map: "IX_RefreshTokensSet_Token") @map("Token")
  expiresAt       DateTime  @map("ExpiresAt") @db.Timestamptz(6)
  revokedAt       DateTime? @map("RevokedAt") @db.Timestamptz(6)
  replacedByToken String?   @map("ReplacedByToken")
  createdByIp     String?   @map("CreatedByIp")
  createdAt       DateTime  @map("CreatedAt") @db.Timestamptz(6)
  updatedAt       DateTime? @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted       Boolean   @map("IsDeleted")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_RefreshTokensSet_UsersSet_UserId")

  @@index([userId], map: "IX_RefreshTokensSet_UserId")
  @@map("RefreshTokensSet")
}

model SavedLocation {
  id         String    @id(map: "PK_SavedLocationsSet") @map("Id") @db.Uuid
  userId     String    @map("UserId") @db.Uuid
  label      String    @map("Label")
  address    String    @map("Address")
  latitude   Float     @map("Latitude")
  longitude  Float     @map("Longitude")
  isFavorite Boolean   @map("IsFavorite")
  createdAt  DateTime  @map("CreatedAt") @db.Timestamptz(6)
  updatedAt  DateTime? @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted  Boolean   @map("IsDeleted")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_SavedLocationsSet_UsersSet_UserId")

  @@index([userId], map: "IX_SavedLocationsSet_UserId")
  @@map("SavedLocationsSet")
}

model Driver {
  id                 String                  @id(map: "PK_DriversSet") @map("Id") @db.Uuid
  userId             String                  @unique(map: "IX_DriversSet_UserId") @map("UserId") @db.Uuid
  vehicleId          String?                 @map("VehicleId") @db.Uuid
  ratingAverage      Decimal                 @map("RatingAverage") @db.Decimal
  ratingCount        Int                     @map("RatingCount")
  isOnline           Boolean                 @map("IsOnline")
  isActive           Boolean                 @map("IsActive")
  createdAt          DateTime                @map("CreatedAt") @db.Timestamptz(6)
  updatedAt          DateTime?               @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted          Boolean                 @map("IsDeleted")
  adminNotes         String?                 @map("AdminNotes")
  birthDate          DateTime?               @map("BirthDate") @db.Date
  licenseExpiry      DateTime?               @map("LicenseExpiry") @db.Date
  licenseNumber      String?                 @map("LicenseNumber")
  licenseType        String?                 @map("LicenseType")
  manufactureYear    Int?                    @map("ManufactureYear")
  nationalId         String?                 @map("NationalId")
  plateNumber        String?                 @map("PlateNumber")
  seats              Int?                    @map("Seats")
  vehicleColor       String?                 @map("VehicleColor")
  vehicleKind        String?                 @map("VehicleKind")
  vehicleModelName   String?                 @map("VehicleModelName")
  verificationStatus Int                     @default(0) @map("VerificationStatus")
  verifiedAt         DateTime?               @map("VerifiedAt") @db.Timestamptz(6)
  documents          DriverDocument[]
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_DriversSet_UsersSet_UserId")
  vehicle            Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_DriversSet_VehiclesSet_VehicleId")
  groupRequests      GroupRequest[]
  rideRequests       RideRequest[]
  assignedDemands    RouteDemandGroupState[] @relation("DemandAssignedDriver")
  trips              Trip[]

  @@index([vehicleId], map: "IX_DriversSet_VehicleId")
  @@map("DriversSet")
}

model DriverDocument {
  id           String    @id(map: "PK_DriverDocumentsSet") @map("Id") @db.Uuid
  driverId     String    @map("DriverId") @db.Uuid
  documentType Int       @map("DocumentType")
  fileName     String    @map("FileName")
  contentType  String    @map("ContentType")
  sizeBytes    BigInt    @map("SizeBytes")
  storagePath  String    @map("StoragePath")
  notes        String?   @map("Notes")
  uploadedBy   String    @map("UploadedBy")
  createdAt    DateTime  @map("CreatedAt") @db.Timestamptz(6)
  updatedAt    DateTime? @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted    Boolean   @map("IsDeleted")
  driver       Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_DriverDocumentsSet_DriversSet_DriverId")

  @@index([driverId], map: "IX_DriverDocumentsSet_DriverId")
  @@map("DriverDocumentsSet")
}

model Vehicle {
  id          String    @id(map: "PK_VehiclesSet") @map("Id") @db.Uuid
  plateNumber String    @map("PlateNumber")
  model       String    @map("Model")
  type        Int       @map("Type")
  capacity    Int       @map("Capacity")
  isActive    Boolean   @map("IsActive")
  createdAt   DateTime  @map("CreatedAt") @db.Timestamptz(6)
  updatedAt   DateTime? @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted   Boolean   @map("IsDeleted")
  drivers     Driver[]

  @@map("VehiclesSet")
}

model Route {
  id                 String                  @id(map: "PK_RoutesSet") @map("Id") @db.Uuid
  name               String                  @map("Name")
  description        String?                 @map("Description")
  startLatitude      Float                   @map("StartLatitude")
  startLongitude     Float                   @map("StartLongitude")
  endLatitude        Float                   @map("EndLatitude")
  endLongitude       Float                   @map("EndLongitude")
  isActive           Boolean                 @map("IsActive")
  createdAt          DateTime                @map("CreatedAt") @db.Timestamptz(6)
  updatedAt          DateTime?               @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted          Boolean                 @map("IsDeleted")
  encodedPolyline    String?                 @map("EncodedPolyline")
  distanceMeters     Int?                    @map("DistanceMeters")
  durationSeconds    Int?                    @map("DurationSeconds")
  boundsMinLatitude  Float?                  @map("BoundsMinLatitude")
  boundsMaxLatitude  Float?                  @map("BoundsMaxLatitude")
  boundsMinLongitude Float?                  @map("BoundsMinLongitude")
  boundsMaxLongitude Float?                  @map("BoundsMaxLongitude")
  waitlistEntries    LandingWaitlistEntry[]
  pricingRules       PricingRule[]
  mappedDemandStates RouteDemandGroupState[] @relation("DemandMappedRoute")
  stops              Stop[]
  trips              Trip[]

  @@map("RoutesSet")
}

model Stop {
  id        String    @id(map: "PK_StopsSet") @map("Id") @db.Uuid
  routeId   String    @map("RouteId") @db.Uuid
  name      String    @map("Name")
  latitude  Float     @map("Latitude")
  longitude Float     @map("Longitude")
  order     Int       @map("Order")
  createdAt DateTime  @map("CreatedAt") @db.Timestamptz(6)
  updatedAt DateTime? @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted Boolean   @map("IsDeleted")
  route     Route     @relation(fields: [routeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_StopsSet_RoutesSet_RouteId")

  @@index([routeId], map: "IX_StopsSet_RouteId")
  @@map("StopsSet")
}

model Trip {
  id             String          @id(map: "PK_TripsSet") @map("Id") @db.Uuid
  routeId        String          @map("RouteId") @db.Uuid
  driverId       String?         @map("DriverId") @db.Uuid
  status         Int             @map("Status")
  scheduledAt    DateTime        @map("ScheduledAt") @db.Timestamptz(6)
  startedAt      DateTime?       @map("StartedAt") @db.Timestamptz(6)
  completedAt    DateTime?       @map("CompletedAt") @db.Timestamptz(6)
  pricePerSeat   Decimal         @map("PricePerSeat") @db.Decimal(18, 2)
  availableSeats Int             @map("AvailableSeats")
  referenceCode  String?         @map("ReferenceCode")
  createdAt      DateTime        @map("CreatedAt") @db.Timestamptz(6)
  updatedAt      DateTime?       @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted      Boolean         @map("IsDeleted")
  bookings       Booking[]
  supportTickets SupportTicket[]
  driver         Driver?         @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_TripsSet_DriversSet_DriverId")
  route          Route           @relation(fields: [routeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_TripsSet_RoutesSet_RouteId")

  @@index([driverId], map: "IX_TripsSet_DriverId")
  @@index([routeId], map: "IX_TripsSet_RouteId")
  @@map("TripsSet")
}

model Booking {
  id                     String    @id(map: "PK_BookingsSet") @map("Id") @db.Uuid
  tripId                 String    @map("TripId") @db.Uuid
  userId                 String    @map("UserId") @db.Uuid
  status                 Int       @map("Status")
  seatCount              Int       @map("SeatCount")
  totalAmount            Decimal   @map("TotalAmount") @db.Decimal(18, 2)
  paymentMethod          String    @map("PaymentMethod")
  referenceCode          String?   @map("ReferenceCode")
  createdAt              DateTime  @map("CreatedAt") @db.Timestamptz(6)
  updatedAt              DateTime? @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted              Boolean   @map("IsDeleted")
  captainEarnings        Decimal   @default(0.0) @map("CaptainEarnings") @db.Decimal(18, 2)
  commissionAmount       Decimal   @default(0.0) @map("CommissionAmount") @db.Decimal(18, 2)
  commissionRate         Decimal   @default(0.0) @map("CommissionRate") @db.Decimal(9, 6)
  pricePerSeat           Decimal   @default(0.0) @map("PricePerSeat") @db.Decimal(18, 2)
  usesSubscriptionCredit Boolean   @default(false) @map("UsesSubscriptionCredit")
  trip                   Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_BookingsSet_TripsSet_TripId")
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_BookingsSet_UsersSet_UserId")
  invoice                Invoice?

  @@index([tripId], map: "IX_BookingsSet_TripId")
  @@index([userId], map: "IX_BookingsSet_UserId")
  @@map("BookingsSet")
}

model Invoice {
  id               String    @id(map: "PK_InvoicesSet") @map("Id") @db.Uuid
  bookingId        String    @unique(map: "IX_InvoicesSet_BookingId") @map("BookingId") @db.Uuid
  amount           Decimal   @map("Amount") @db.Decimal(18, 2)
  status           Int       @map("Status")
  paymentReference String?   @map("PaymentReference")
  paidAt           DateTime? @map("PaidAt") @db.Timestamptz(6)
  createdAt        DateTime  @map("CreatedAt") @db.Timestamptz(6)
  updatedAt        DateTime? @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted        Boolean   @map("IsDeleted")
  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_InvoicesSet_BookingsSet_BookingId")

  @@map("InvoicesSet")
}

model Wallet {
  id           String              @id(map: "PK_WalletsSet") @map("Id") @db.Uuid
  userId       String              @unique(map: "IX_WalletsSet_UserId") @map("UserId") @db.Uuid
  balance      Decimal             @map("Balance") @db.Decimal
  currency     String              @map("Currency")
  createdAt    DateTime            @map("CreatedAt") @db.Timestamptz(6)
  updatedAt    DateTime?           @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted    Boolean             @map("IsDeleted")
  transactions WalletTransaction[]
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_WalletsSet_UsersSet_UserId")

  @@map("WalletsSet")
}

model WalletTransaction {
  id          String    @id(map: "PK_WalletTransactionsSet") @map("Id") @db.Uuid
  walletId    String    @map("WalletId") @db.Uuid
  amount      Decimal   @map("Amount") @db.Decimal
  type        String    @map("Type")
  description String?   @map("Description")
  reference   String?   @map("Reference")
  createdAt   DateTime  @map("CreatedAt") @db.Timestamptz(6)
  updatedAt   DateTime? @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted   Boolean   @map("IsDeleted")
  wallet      Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_WalletTransactionsSet_WalletsSet_WalletId")

  @@index([walletId], map: "IX_WalletTransactionsSet_WalletId")
  @@map("WalletTransactionsSet")
}

model Review {
  id        String    @id(map: "PK_ReviewsSet") @map("Id") @db.Uuid
  tripId    String    @map("TripId") @db.Uuid
  userId    String    @map("UserId") @db.Uuid
  driverId  String?   @map("DriverId") @db.Uuid
  stars     Int       @map("Stars")
  comment   String?   @map("Comment")
  createdAt DateTime  @map("CreatedAt") @db.Timestamptz(6)
  updatedAt DateTime? @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted Boolean   @map("IsDeleted")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_ReviewsSet_UsersSet_UserId")

  @@index([userId], map: "IX_ReviewsSet_UserId")
  @@map("ReviewsSet")
}

model Notification {
  id        String    @id(map: "PK_NotificationsSet") @map("Id") @db.Uuid
  userId    String    @map("UserId") @db.Uuid
  title     String    @map("Title")
  body      String    @map("Body")
  type      String?   @map("Type")
  isRead    Boolean   @map("IsRead")
  readAt    DateTime? @map("ReadAt") @db.Timestamptz(6)
  createdAt DateTime  @map("CreatedAt") @db.Timestamptz(6)
  updatedAt DateTime? @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted Boolean   @map("IsDeleted")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_NotificationsSet_UsersSet_UserId")

  @@index([userId], map: "IX_NotificationsSet_UserId")
  @@map("NotificationsSet")
}

model UserDevice {
  id         String    @id(map: "PK_UserDevicesSet") @map("Id") @db.Uuid
  userId     String    @map("UserId") @db.Uuid
  token      String    @map("Token") @db.VarChar(512)
  platform   String    @map("Platform") @db.VarChar(32)
  isActive   Boolean   @map("IsActive")
  lastSeenAt DateTime? @map("LastSeenAt") @db.Timestamptz(6)
  createdAt  DateTime  @map("CreatedAt") @db.Timestamptz(6)
  updatedAt  DateTime? @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted  Boolean   @map("IsDeleted")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_UserDevicesSet_UsersSet_UserId")

  @@unique([userId, token], map: "IX_UserDevicesSet_UserId_Token")
  @@index([token], map: "IX_UserDevicesSet_Token")
  @@index([userId], map: "IX_UserDevicesSet_UserId")
  @@map("UserDevicesSet")
}

model FaqItem {
  id        String    @id(map: "PK_FaqItemsSet") @map("Id") @db.Uuid
  question  String    @map("Question")
  answer    String    @map("Answer")
  order     Int       @map("Order")
  isActive  Boolean   @map("IsActive")
  createdAt DateTime  @map("CreatedAt") @db.Timestamptz(6)
  updatedAt DateTime? @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted Boolean   @map("IsDeleted")

  @@map("FaqItemsSet")
}

model LegalDocument {
  id        String    @id(map: "PK_LegalDocumentsSet") @map("Id") @db.Uuid
  slug      String    @unique(map: "IX_LegalDocumentsSet_Slug") @map("Slug")
  title     String    @map("Title")
  content   String    @map("Content")
  isActive  Boolean   @map("IsActive")
  createdAt DateTime  @map("CreatedAt") @db.Timestamptz(6)
  updatedAt DateTime? @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted Boolean   @map("IsDeleted")
  contentEn String?   @map("ContentEn")
  titleEn   String?   @map("TitleEn")

  @@map("LegalDocumentsSet")
}

model SupportTicket {
  id        String           @id(map: "PK_SupportTicketsSet") @map("Id") @db.Uuid
  userId    String           @map("UserId") @db.Uuid
  subject   String           @map("Subject")
  status    String           @map("Status")
  closedAt  DateTime?        @map("ClosedAt") @db.Timestamptz(6)
  createdAt DateTime         @map("CreatedAt") @db.Timestamptz(6)
  updatedAt DateTime?        @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted Boolean          @map("IsDeleted")
  tripId    String?          @map("TripId") @db.Uuid
  messages  SupportMessage[]
  trip      Trip?            @relation(fields: [tripId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_SupportTicketsSet_TripsSet_TripId")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_SupportTicketsSet_UsersSet_UserId")

  @@index([tripId], map: "IX_SupportTicketsSet_TripId")
  @@index([userId], map: "IX_SupportTicketsSet_UserId")
  @@map("SupportTicketsSet")
}

model SupportMessage {
  id            String        @id(map: "PK_SupportMessagesSet") @map("Id") @db.Uuid
  ticketId      String        @map("TicketId") @db.Uuid
  senderId      String        @map("SenderId") @db.Uuid
  isFromSupport Boolean       @map("IsFromSupport")
  content       String        @map("Content")
  createdAt     DateTime      @map("CreatedAt") @db.Timestamptz(6)
  updatedAt     DateTime?     @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted     Boolean       @map("IsDeleted")
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_SupportMessagesSet_SupportTicketsSet_TicketId")

  @@index([ticketId], map: "IX_SupportMessagesSet_TicketId")
  @@map("SupportMessagesSet")
}

model RouteRequest {
  id                   String    @id(map: "PK_RouteRequestsSet") @map("Id") @db.Uuid
  userId               String    @map("UserId") @db.Uuid
  fromAddress          String    @map("FromAddress")
  toAddress            String    @map("ToAddress")
  fromLatitude         Float     @map("FromLatitude")
  fromLongitude        Float     @map("FromLongitude")
  toLatitude           Float     @map("ToLatitude")
  toLongitude          Float     @map("ToLongitude")
  status               String    @map("Status")
  notes                String?   @map("Notes")
  createdAt            DateTime  @map("CreatedAt") @db.Timestamptz(6)
  updatedAt            DateTime? @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted            Boolean   @map("IsDeleted")
  preferredVehicleType String    @default("") @map("PreferredVehicleType")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_RouteRequestsSet_UsersSet_UserId")

  @@index([userId], map: "IX_RouteRequestsSet_UserId")
  @@map("RouteRequestsSet")
}

model SubscriptionPackage {
  id           String    @id(map: "PK_SubscriptionPackagesSet") @map("Id") @db.Uuid
  name         String    @map("Name")
  description  String?   @map("Description")
  price        Decimal   @map("Price") @db.Decimal
  tripCount    Int       @map("TripCount")
  validityDays Int       @map("ValidityDays")
  isActive     Boolean   @map("IsActive")
  createdAt    DateTime  @map("CreatedAt") @db.Timestamptz(6)
  updatedAt    DateTime? @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted    Boolean   @map("IsDeleted")

  @@map("SubscriptionPackagesSet")
}

model LandingRouteLead {
  id          String    @id(map: "PK_LandingRouteLeadsSet") @map("Id") @db.Uuid
  phone       String    @map("Phone")
  fromCity    String    @map("FromCity")
  fromRegion  String    @map("FromRegion")
  fromTime    String?   @map("FromTime")
  toCity      String    @map("ToCity")
  toRegion    String    @map("ToRegion")
  toTime      String?   @map("ToTime")
  weeklyCount Int       @map("WeeklyCount")
  usageDays   String?   @map("UsageDays")
  usageReason String?   @map("UsageReason")
  source      String    @map("Source")
  createdAt   DateTime  @map("CreatedAt") @db.Timestamptz(6)
  updatedAt   DateTime? @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted   Boolean   @map("IsDeleted")

  @@map("LandingRouteLeadsSet")
}

model LandingWaitlistEntry {
  id        String    @id(map: "PK_LandingWaitlistEntriesSet") @map("Id") @db.Uuid
  phone     String    @map("Phone")
  fullName  String?   @map("FullName")
  source    String    @map("Source")
  createdAt DateTime  @map("CreatedAt") @db.Timestamptz(6)
  updatedAt DateTime? @map("UpdatedAt") @db.Timestamptz(6)
  isDeleted Boolean   @map("IsDeleted")
  routeFrom String?   @map("RouteFrom")
  routeId   String?   @map("RouteId") @db.Uuid
  routeTo   String?   @map("RouteTo")
  route     Route?    @relation(fields: [routeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_LandingWaitlistEntriesSet_RoutesSet_RouteId")

  @@index([routeId], map: "IX_LandingWaitlistEntriesSet_RouteId")
  @@map("LandingWaitlistEntriesSet")
}

model LandingCaptainLead {
  id          String    @id(map: "PK_LandingCaptainLeadsSet") @map("Id") @db.Uuid
  phone       String    @map("Phone")
  fullName    String?   @map("FullName")
  vehicleType String?   @map("VehicleType")
  notes       String?   @map("Notes")
  source      String    @map("Source")
  createdAt   DateTime  @map("CreatedAt") @db.Timestamptz(6)
