# Existing Neon PostgreSQL (source of truth). Do not create a new database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

PORT=3000
NODE_ENV=development

# JWT — must match the .NET Jwt section for token compatibility
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ISSUER=Shuttlez
JWT_AUDIENCE=ShuttlezApp
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

# OTP
OTP_CODE_LENGTH=4
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LOG_CODE_IN_DEVELOPMENT=true
OTP_DELIVER_CODE_FOR_CLIENT_PUSH=true

# CORS (comma-separated). Leave empty to use the same production defaults as .NET.
CORS_ALLOWED_ORIGINS=https://shuttlez.org,https://www.shuttlez.org,http://localhost:4200,https://localhost:4200,http://localhost:4300,https://localhost:4300,https://shuttlez-dashboard.web.app,https://shuttlez-dashboard.firebaseapp.com,https://shuttlez-landing.web.app,https://shuttlez-landing.firebaseapp.com

# Google Maps Directions
GOOGLE_MAPS_API_KEY=
GOOGLE_DIRECTIONS_BASE_URL=https://maps.googleapis.com/maps/api/directions/json

# Route matching
ROUTE_MATCHING_MAX_DISTANCE_METERS=300
ROUTE_MATCHING_MAX_POLYLINE_POINTS=500

# Captain launch offer
CAPTAIN_LAUNCH_TOTAL_SLOTS=500
CAPTAIN_LAUNCH_PROFIT_PERCENT=100
CAPTAIN_LAUNCH_FIRST_TRIPS=100
CAPTAIN_LAUNCH_DURATION_MONTHS=3

# Shuttle commission
SHUTTLE_PLATFORM_COMMISSION_PERCENT=0
SHUTTLE_PREFER_LAUNCH_OFFER_PERCENT=true

# Firebase (social login + FCM). Leave empty to disable social auth like unconfigured .NET.
# On Cloud Functions, ADC is used when FIREBASE_CREDENTIALS_PATH is empty.
FIREBASE_PROJECT_ID=shuttlez-api
FIREBASE_CREDENTIALS_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

# Local file uploads (maps to ASP.NET wwwroot/uploads)
UPLOAD_DIR=uploads
WEB_ROOT=uploads
